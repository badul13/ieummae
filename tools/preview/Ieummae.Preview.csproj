<Project Sdk="Microsoft.NET.Sdk">
  <!-- 화면 미리보기 - 창 없이 헤드리스로 그려 PNG + 브라우저용 페이지 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <ProjectReference Include="..\..\src\Ieummae.App\Ieummae.App.csproj" />
  </ItemGroup>
</Project>
