<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 천 조각(patch) - 배경 + 안쪽 점선 박음질 -->
  <Style Selector="ContentControl.patch">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="18" BoxShadow="{DynamicResource PatchShadow}" />
          <Rectangle Margin="6" RadiusX="13" RadiusY="13" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" StrokeDashArray="3,2.4" />
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ContentControl.patch.hot">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStitch}" />
  </Style>
  <Style Selector="Button.patch">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontJua}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="12" BoxShadow="{DynamicResource PatchShadowSm}" />
          <Rectangle Margin="3.5" RadiusX="9" RadiusY="9" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.3" StrokeDashArray="2.6,2.2" />
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.patch.hot">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.hand">
    <Setter Property="FontFamily" Value="{DynamicResource FontHand}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>
  <!-- 테두리·배경 없는 버튼 - 내용만 -->
  <Style Selector="Button.bare">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Background="Transparent" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.bare:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.1)" />
  </Style>
  <!-- 더보기 메뉴 - 천 조각 카드 -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource FontJua}" />
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:pointerover /template/ Border">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator">
    <Setter Property="Background" Value="{DynamicResource Stitch}" />
  </Style>

  <Style Selector="SelectableTextBlock.hand">
    <Setter Property="FontFamily" Value="{DynamicResource FontHand}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <!-- 입력 칸 - 천 바탕 + 실 색 테두리, 누르면 강조색 -->
  <Style Selector="TextBox.sew">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="BorderThickness" Value="1.5" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentLine}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontJua}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="TextBox.sew:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
  </Style>
  <Style Selector="TextBox.sew:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>
  <Style Selector="TextBox.sew">
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Muted}" />
  </Style>
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>
  <!-- 이름표 - 브랜치·태그·원격 -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3,9,9,3" />
    <Setter Property="Padding" Value="6,1,9,1" />
  </Style>

  <!-- 누를 수 없는 버튼 - 흐리게 -->
  <Style Selector="Button.patch:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- 코드 입력 칸 - 고정폭, 합자 끔 -->
  <Style Selector="TextBox.sew.code">
    <Setter Property="FontFamily" Value="{DynamicResource FontMono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFeatures" Value="{DynamicResource NoLigatures}" />
  </Style>
</Styles>
