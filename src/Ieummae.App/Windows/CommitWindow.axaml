<w:IeumWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Ieummae.App.Windows"
        xmlns:theme="clr-namespace:Ieummae.App.Theme"
        x:Class="Ieummae.App.Windows.CommitWindow"
        x:DataType="w:RepoModel"
        Width="1240" Height="800">
  <Grid RowDefinitions="156,Auto,*">
    <w:WoolTop />

    <DockPanel Grid.Row="1" Margin="28,12,26,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <Button Classes="patch" Content="Refresh" />
        <Button Classes="patch" Content="Log" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Commit" FontSize="22" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" Classes="hand" VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
        <w:BranchChip />
      </StackPanel>
    </DockPanel>

    <!-- 본문 - Changes 체크 목록·메시지 카드 / diff (4단계) -->
    <Grid Grid.Row="2" ColumnDefinitions="400,*" Margin="20,0,20,20">
      <DockPanel>
        <ContentControl DockPanel.Dock="Bottom" Classes="patch hot" Margin="0,14,0,0" Padding="22,16,20,16">
          <StackPanel Spacing="8">
            <TextBlock Text="Message" Classes="hand" FontWeight="Bold" Foreground="{DynamicResource Text}" FontSize="18" />
            <TextBox Height="78" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                     FontFamily="{DynamicResource FontJua}" FontSize="16" Foreground="{DynamicResource Text}">
              <TextBox.Styles>
                <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement, TextBox:focus /template/ Border#PART_BorderElement">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderThickness" Value="0" />
                </Style>
              </TextBox.Styles>
            </TextBox>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="patch hot" Content="Commit" />
              <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <CheckBox Content="Amend" FontSize="14" />
                <CheckBox Content="Push" FontSize="14" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </ContentControl>
        <theme:KnitPanel Yarn="Knit2" Padding="24,18,16,14">
          <TextBlock Text="Changes" Classes="hand" FontWeight="Bold" Foreground="{DynamicResource Text}" FontSize="18" VerticalAlignment="Top" />
        </theme:KnitPanel>
      </DockPanel>
      <theme:KnitPanel Grid.Column="1" Margin="16,0,0,0" Padding="16,18,16,14" />
    </Grid>
  </Grid>
</w:IeumWindow>
