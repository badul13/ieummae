<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:Ieummae.App.Windows"
             x:Class="Ieummae.App.Windows.BranchChip"
             x:DataType="w:RepoModel"
             VerticalAlignment="Center"
             IsVisible="{Binding Branch, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
  <!-- 브랜치 이름표 + 추적 브랜치 대비 앞섬·뒤처짐 - 창 표시 후 git 조회가 끝나면 나타남 -->
  <StackPanel Orientation="Horizontal" Spacing="8">
    <Border Background="{DynamicResource Surface}" CornerRadius="4,10,10,4" Padding="8,2,11,2" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Ellipse Width="7" Height="7" Fill="{DynamicResource Bg}" Stroke="{DynamicResource Muzzle}" StrokeThickness="1.4" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Branch}" FontSize="13.5" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding SyncText}" Classes="hand" VerticalAlignment="Center" />
  </StackPanel>
</UserControl>
