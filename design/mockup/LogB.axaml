<local:MockWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IeumMock"
        x:Class="IeumMock.LogB"
        x:DataType="local:MockWindow"
        Width="1240" Height="800" WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource Bg}" FontFamily="{DynamicResource FontJua}" FontSize="14.5">
  <local:MockWindow.Styles>
    <StyleInclude Source="avares://ieum-mock/SewStyles.axaml" />
  </local:MockWindow.Styles>
  <Grid RowDefinitions="156,Auto,*">
    <local:WoolTop />

    <DockPanel Grid.Row="1" Margin="28,12,26,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
        <!-- 원격 버튼 - 글자 앞 단추 -->
        <Button Classes="patch" Background="{DynamicResource RemoteBg}" Padding="12,8,16,8">
          <StackPanel Orientation="Horizontal" Spacing="6"><local:SewDot Lane="0" VerticalAlignment="Center" /><TextBlock Text="Fetch" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="patch" Background="{DynamicResource RemoteBg}" Padding="12,8,16,8">
          <StackPanel Orientation="Horizontal" Spacing="6"><local:SewDot Lane="0" VerticalAlignment="Center" /><TextBlock Text="Pull" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="patch" Background="{DynamicResource RemoteBg}" Padding="12,8,16,8">
          <StackPanel Orientation="Horizontal" Spacing="6"><local:SewDot Lane="0" VerticalAlignment="Center" /><TextBlock Text="{Binding PushText}" VerticalAlignment="Center" /></StackPanel>
        </Button>
        <Button Classes="patch hot" Content="Commit" />
        <!-- 더보기 - 버튼에 없는 나머지 명령, 점 셋은 Jua 에 … 글자가 없어 직접 그림 -->
        <Button Classes="patch" Padding="12,8" ToolTip.Tip="More">
          <StackPanel Orientation="Horizontal" Spacing="3.5" Height="20" VerticalAlignment="Center">
            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Text}" VerticalAlignment="Center" />
            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Text}" VerticalAlignment="Center" />
            <Ellipse Width="4.5" Height="4.5" Fill="{DynamicResource Text}" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Switch" />
              <MenuItem Header="New Branch" />
              <MenuItem Header="Merge" />
              <MenuItem Header="Rebase" />
              <Separator />
              <MenuItem Header="Stash" />
              <MenuItem Header="Stash Pop" />
              <Separator />
              <MenuItem Header="Tag" />
              <MenuItem Header="Remotes" />
              <Separator />
              <MenuItem Header="설정" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding RepoName}" FontSize="22" VerticalAlignment="Center" />
        <Border Background="{DynamicResource Surface}" CornerRadius="4,10,10,4" Padding="8,2,11,2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource Bg}" Stroke="{DynamicResource Muzzle}" StrokeThickness="1.4" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BranchName}" FontSize="13.5" Foreground="{DynamicResource Text}" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding AheadText}" Classes="hand" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CommitCount}" Classes="hand" VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,380" Margin="20,0,20,20">
      <local:KnitPanel Padding="12,16,12,14">
        <ListBox x:Name="List" ItemsSource="{Binding Commits}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:Commit">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="38">
                <local:GraphCell Row="{Binding}" ClipToBounds="True" />
                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                  <ItemsControl DockPanel.Dock="Left" Margin="0,0,7,0" ItemsSource="{Binding Badges}" IsVisible="{Binding HasBadges}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:Badge">
                        <Border Background="{Binding SoftBrush}" CornerRadius="3,9,9,3" Padding="6,1,9,1">
                          <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Surface}" Stroke="{Binding LaneBrush}" StrokeThickness="1.3" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource Text}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Msg}" FontSize="15" TextTrimming="{x:Static local:DotsTrimming.End}" />
                </DockPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="10,0,10,0">
                  <TextBlock Text="{Binding Author}" Classes="hand" />
                  <TextBlock Text="{Binding Rel}" Classes="hand" Foreground="{DynamicResource Accent}" MinWidth="52" TextAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </local:KnitPanel>

      <DockPanel Grid.Column="1" Margin="16,0,0,0">
        <ContentControl DockPanel.Dock="Top" Classes="patch hot">
          <StackPanel Spacing="8">
            <DockPanel>
              <TextBlock Text="{Binding Sel.Hash}" Classes="hand" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Sel.Msg}" FontSize="18" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Sel.Body}" IsVisible="{Binding Sel.HasBody}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="20" MaxHeight="120" TextTrimming="{x:Static local:DotsTrimming.End}" />
            <TextBlock Classes="hand" Margin="0,4,0,0"><Run Text="{Binding Sel.Author}" /><Run Text=" · " /><Run Text="{Binding Sel.DateText}" /></TextBlock>
          </StackPanel>
        </ContentControl>
        <local:KnitPanel Yarn="Knit2" Margin="0,14,0,0" Padding="22,18,18,16">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ChangesTitle}" Classes="hand" FontWeight="Bold" Foreground="{DynamicResource Text}" FontSize="18" Margin="0,0,0,6" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:FileChange">
                    <Grid ColumnDefinitions="18,*,48,40" Margin="0,4,16,4">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentLine}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="{x:Static local:DotsTrimming.End}" />
                      <TextBlock Grid.Column="2" TextAlignment="Right" Text="{Binding AddText}" Foreground="{DynamicResource AddFg}" FontSize="13.5" />
                      <TextBlock Grid.Column="3" TextAlignment="Right" Text="{Binding DelText}" Foreground="{DynamicResource DelFg}" FontSize="13.5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </local:KnitPanel>
      </DockPanel>
    </Grid>
  </Grid>
</local:MockWindow>
