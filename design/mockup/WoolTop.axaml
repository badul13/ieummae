<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IeumMock"
             x:Class="IeumMock.WoolTop"
             x:DataType="local:MockWindow">
  <!-- 창 윗부분 - 양털 위로 치켜든 얼굴, 왼쪽에 앱 이름·저장소 -->
  <Panel Height="156">
    <local:WoolHeader IsHitTestVisible="False" />
    <StackPanel Margin="26,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="ieummae" FontFamily="{DynamicResource FontHand}" FontWeight="Bold" FontSize="19" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
        <!-- 테마 - 상아 단추 / 숯색 단추, 꿰맨 쪽이 지금 테마 -->
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="bare" Tag="0" Click="OnPalette" ToolTip.Tip="Light"><local:ThemeButton Pal="0" /></Button>
          <Button Classes="bare" Tag="1" Click="OnPalette" ToolTip.Tip="Dark"><local:ThemeButton Pal="1" /></Button>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Panel>
</UserControl>
