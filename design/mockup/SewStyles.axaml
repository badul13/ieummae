<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 바느질 시안 - 천 조각(patch): 배경 + 안쪽 점선 박음질 -->
  <Style Selector="ContentControl.patch">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="18" BoxShadow="{DynamicResource PatchShadow}" />
          <Rectangle Margin="6" RadiusX="13" RadiusY="13" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" StrokeDashArray="3,2.4" />
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ContentControl.patch.hot">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStitch}" />
  </Style>
  <Style Selector="Button.patch">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stitch}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontJua}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}" CornerRadius="12" BoxShadow="{DynamicResource PatchShadowSm}" />
          <Rectangle Margin="3.5" RadiusX="9" RadiusY="9" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.3" StrokeDashArray="2.6,2.2" />
          <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.patch.hot">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="TextBlock.hand">
    <Setter Property="FontFamily" Value="{DynamicResource FontHand}" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="Line.stitch">
    <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    <Setter Property="StrokeThickness" Value="2.4" />
    <Setter Property="StrokeDashArray" Value="1.4,1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="ListBoxItem /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Sel}" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
</Styles>
